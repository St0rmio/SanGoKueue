# Local, hors Docker
REDIS_URL=redis://127.0.0.1:6379

# Docker Compose. Remplacer les mots de passe avant de lancer.
POSTGRES_DB=sangokueue_db
POSTGRES_USER=sango_user
POSTGRES_PASSWORD=changer-moi
DATABASE_URL=postgres://sango_user:changer-moi@db:5432/sangokueue_db
REDIS_PASSWORD=changer-moi
